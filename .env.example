# String de conexão do Postgres. No Railway, adicione um serviço
# "PostgreSQL" ao projeto e copie a variável DATABASE_URL gerada por ele
# (Settings > Variables do serviço Postgres, ou referencie ${{Postgres.DATABASE_URL}}
# nas variáveis do serviço da aplicação).
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# Deixe como está (padrão) para exigir SSL na conexão com o Postgres.
# Só use "disable" se estiver rodando um Postgres local sem SSL.
# PGSSLMODE=disable

# Senha do painel administrativo (troque por uma senha forte)
ADMIN_PASSWORD=troque-esta-senha

# Segredo usado para assinar o cookie de sessão do admin
SESSION_SECRET=troque-este-segredo-tambem

# ID do Google AdSense (formato ca-pub-XXXXXXXXXXXXXXXX)
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000

# Chave secreta para proteger o endpoint de atualização automática do RSS
# (usada por um cron job / GitHub Action / Vercel Cron)
RSS_REFRESH_SECRET=troque-esta-chave

# URL pública do site (usada para gerar links de compartilhamento e sitemap)
NEXT_PUBLIC_SITE_URL=https://seusite.com.br
